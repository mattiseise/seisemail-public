<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>fi.seise.mail.daemon</string>
  <key>ProgramArguments</key><array><string>__BIN__</string><string>run</string></array>
  <key>WorkingDirectory</key><string>__DAEMON_DIR__</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>ExitTimeOut</key><integer>20</integer>
  <key>ProcessType</key><string>Standard</string>
  <key>Umask</key><integer>63</integer>
  <key>StandardOutPath</key><string>__LOGS__/daemon.stdout.log</string>
  <key>StandardErrorPath</key><string>__LOGS__/daemon.stderr.log</string>
</dict>
</plist>
