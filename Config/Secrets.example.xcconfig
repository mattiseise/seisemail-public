// Kopioi tämä tiedostoksi Config/Secrets.xcconfig ja täytä Google Cloudin
// OAuth-tunnusten tiedot. Älä vie gitiin.

// Mac: "Desktop app" -tyyppinen asiakas.
GOOGLE_CLIENT_ID = 1234567890-abc.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET = GOCSPX-xxxxxxxx

// iPhone: "iOS"-tyyppinen asiakas, jonka bundle ID on sama kuin IOS_BUNDLE_ID alla. Sillä ei ole secretiä.
GOOGLE_IOS_CLIENT_ID = 1234567890-xyz.apps.googleusercontent.com

// Apple Developer -tiimisi tunnus (developer.apple.com → Membership), iPhone-allekirjoitusta varten.
DEVELOPMENT_TEAM = ABCDE12345

// iPhone-sovelluksen bundle ID. Valitse oma, esim. com.sukunimi.mail.ios.
IOS_BUNDLE_ID = com.example.mail.ios
